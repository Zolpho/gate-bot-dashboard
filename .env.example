# Start safely with generated sample data. Change to false after both account probes work.
DEMO_MODE=true

# Multi-account configuration. Gate credentials are copied read-only; the dashboard user file is mounted writable for self-service password changes.
GATE_ACCOUNTS_FILE=/run/secrets/gate_accounts.json
DASHBOARD_USERS_FILE=/run/secrets/dashboard_users.json
DASHBOARD_USERS_BACKUP_DIR=/data/dashboard-user-backups
DASHBOARD_USERS_BACKUP_KEEP=20

# Legacy single-account variables. Leave empty when using GATE_ACCOUNTS_FILE.
GATE_API_KEY=
GATE_API_SECRET=
GATE_ACCOUNT_ID=default
GATE_ACCOUNT_NAME=Default account
GATE_ACCOUNT_TYPE=subaccount
GATE_UID=

GATE_BASE_URL=https://api.gateio.ws/api/v4
GATE_LANGUAGE=en-US
GATE_REQUEST_TIMEOUT_SECONDS=20
GATE_BOT_PAGE_SIZE=50
GATE_DETAILS_CONCURRENCY=4
GATE_ACCOUNT_CONCURRENCY=4

# Authenticated private-balance panel
BALANCE_CACHE_SECONDS=30
BALANCE_DUST_USDT=0.01

# Gate deposit catalogue, network discovery, addresses and QR
DEPOSIT_CATALOG_CACHE_SECONDS=900
DEPOSIT_ADDRESS_CACHE_SECONDS=300
DEPOSIT_FAVORITES=USDT,EQTY,BTC,ETH

# Collector and storage
POLL_SECONDS=60
DATABASE_URL=sqlite:////data/gate_bots.db
SNAPSHOT_RETENTION_DAYS=365
STALE_AFTER_MINUTES=5
MISSING_BOT_GRACE_SYNCS=2
PURGE_DEMO_DATA_ON_LIVE=true

# Public GET routes do not require authentication.
# Optional legacy super-admin credentials for protected actions only.
# Prefer secrets/dashboard_users.json for per-account users.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# GitHub Pages origin(s), comma-separated. Update after repository transfer.
CORS_ORIGINS=https://zolpho.github.io

# Dangerous operation: remains false for a monitoring-only deployment.
ALLOW_BOT_STOP=false
BOT_STOP_CONFIRMATION_TEXT=STOP

# Default local rules created on first launch
DEFAULT_DRAWDOWN_ALERT_PCT=12
DEFAULT_LOSS_ALERT_USDT=100
DEFAULT_LIQUIDATION_DISTANCE_PCT=10
ALERT_COOLDOWN_SECONDS=3600

APP_ENV=production
LOG_LEVEL=INFO
